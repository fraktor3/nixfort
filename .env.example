# Скопируй в .env и заполни. .env НЕ коммитится.
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=change-me-50-random-chars
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,10.77.0.10
DJANGO_CSRF_TRUSTED_ORIGINS=https://127.0.0.1:8443,https://10.77.0.10
POSTGRES_DB=nixfort
POSTGRES_USER=nixfort
POSTGRES_PASSWORD=change-me
# Пароль Redis (обязателен, ADR-026). REDIS_URL собирается в compose.yaml из этого пароля.
REDIS_PASSWORD=change-me
NIXFORT_CONTROLLER_KEY_PATH=/run/secrets/controller_ed25519
NIXFORT_ROLLBACK_TIMEOUT_S=90
